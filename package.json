{
    "name": "@magnesium/theme",
    "version": "5.3.0",
    "description": "Sass toolkit for managing design tokens as CSS custom properties.",
    "type": "module",
    "scripts": {
        "dev": "vite playground",
        "lint:css": "stylelint --fix \"**/*.scss\"",
        "lint:js": "eslint --fix .",
        "lint": "npm-run-all --parallel lint:*",
        "test": "vitest run",
        "test:watch": "vitest",
        "prepare": "husky",
        "release": "semantic-release"
    },
    "engines": {
        "node": ">=22"
    },
    "sass": "index.scss",
    "exports": {
        ".": {
            "sass": "./index.scss"
        },
        "./compat": {
            "sass": "./compat.scss"
        },
        "./package.json": "./package.json"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@front-factory/eslint-config": "^2.4.2",
        "@front-factory/stylelint-config": "^1.12.1",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/github": "^12.0.9",
        "conventional-changelog-conventionalcommits": "^9.3.1",
        "eslint": "^10.10.0",
        "husky": "^9.1.7",
        "npm-run-all2": "^9.0.3",
        "sass": "^1.104.1",
        "sass-true": "^10.1.0",
        "semantic-release": "^25.0.9",
        "stylelint": "^17.15.0",
        "vite": "^8.3.0",
        "vitest": "^5.0.0"
    },
    "dependencies": {
        "@unsass/css": "^3.1.0",
        "@unsass/string": "^1.4.4",
        "@unsass/types": "^1.0.1",
        "@unsass/var": "^1.0.3"
    },
    "peerDependencies": {
        "sass": "^1.104.1",
        "sass-embedded": "^1.104.1"
    },
    "peerDependenciesMeta": {
        "sass": {
            "optional": true
        },
        "sass-embedded": {
            "optional": true
        }
    },
    "keywords": [
        "magnesium",
        "sass",
        "scss",
        "design-tokens",
        "design-system",
        "theme",
        "theming",
        "tokens",
        "css-custom-properties",
        "css-variables"
    ],
    "license": "MIT",
    "homepage": "https://github.com/magnesiumlabs/magnesium",
    "bugs": {
        "url": "https://github.com/magnesiumlabs/magnesium/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/magnesiumlabs/magnesium.git"
    },
    "files": [
        "src/*.scss",
        "*.scss"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    }
}
